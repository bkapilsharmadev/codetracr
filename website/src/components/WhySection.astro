---
import { homepage } from "../data/siteCopy";

const impactIcon: Record<string, string> = {
  api: "M12 2a10 10 0 100 20 10 10 0 000-20zm0 0c2.5 3 4 6.5 4 10s-1.5 7-4 10m0-20c-2.5 3-4 6.5-4 10s1.5 7 4 10M2 12h20",
  db: "M4 6c0 1.7 3.6 3 8 3s8-1.3 8-3-3.6-3-8-3-8 1.3-8 3zm0 6c0 1.7 3.6 3 8 3s8-1.3 8-3M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6",
  event: "M5 12h3l2-6 4 12 2-6h3",
  service: "M16 18v-2a4 4 0 00-8 0v2M12 10a3 3 0 100-6 3 3 0 000 6zM19 18v-1.5a3 3 0 00-2-2.8M5 18v-1.5a3 3 0 012-2.8",
};

const impactColor: Record<string, string> = {
  api: "text-brand",
  db: "text-icon-teal",
  event: "text-icon-amber",
  service: "text-icon-rose",
};
---

<section id="why" class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-16 items-center">
    <div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-ink leading-tight">{homepage.why.title}</h2>
      <p class="mt-5 text-base text-neutral-600 leading-relaxed max-w-md">{homepage.why.description}</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-line bg-ink text-white p-5 font-mono text-[12px] leading-6 overflow-hidden">
        <p class="text-[10px] uppercase tracking-widest text-neutral-400 mb-3">{homepage.why.fileName}</p>
        <pre class="whitespace-pre text-[11px] sm:text-[12px] leading-5 text-neutral-200"><code>{`export class OrderService {
  async create(input) {
    const order =
      await this.repo.save(input);
    await this.bus.publish(
      "OrderCreated",
      order
    );
    return order;
  }
}`}</code></pre>
      </div>

      <div class="rounded-2xl border border-line bg-white p-5">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-neutral-400 mb-4">Ripple from create()</p>
        <div class="mb-4 rounded-lg bg-wash px-3 py-2 text-[13px] font-semibold font-mono text-ink ring-1 ring-line">
          OrderService.create
        </div>
        <ul class="space-y-2">
          {homepage.why.impacts.map((item) => (
            <li class="flex items-center gap-2.5">
              <span class:list={["flex h-7 w-7 items-center justify-center rounded-md shrink-0 bg-wash", impactColor[item.icon]]}>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d={impactIcon[item.icon]} />
                </svg>
              </span>
              <span class="text-[13px] font-medium text-ink font-mono truncate">{item.label}</span>
              <span class="ml-auto text-[10px] uppercase tracking-wider text-muted">{item.kind}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
