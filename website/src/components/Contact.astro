---
import { homepage, links } from "../data/siteCopy";

const contactLinks = [
  {
    href: links.personal,
    label: "bkapilsharma.com",
    external: true,
    iconClass: "text-icon-amber",
    icon: "web",
  },
  {
    href: links.linkedin,
    label: "LinkedIn",
    external: true,
    iconClass: "text-brand",
    icon: "linkedin",
  },
  {
    href: links.githubProfile,
    label: "GitHub",
    external: true,
    iconClass: "text-ink",
    icon: "github",
  },
  {
    href: links.email,
    label: links.emailLabel,
    external: false,
    iconClass: "text-icon-teal",
    icon: "email",
  },
] as const;
---

<section id="contact" class="px-4 sm:px-6 lg:px-8 pb-20">
  <div class="max-w-6xl mx-auto border-t border-line pt-16">
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-muted mb-3">{homepage.contact.eyebrow}</p>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-ink mb-10">{homepage.contact.title}</h2>

    <article class="grid overflow-hidden rounded-3xl border border-line bg-wash md:grid-cols-[minmax(280px,42%)_1fr]">
      <div class="relative h-64 md:h-full">
        <img
          src={homepage.contact.founder.photo}
          alt={homepage.contact.founder.name}
          width="480"
          height="480"
          class="h-full w-full object-cover object-[center_18%] md:absolute md:inset-0"
        />
      </div>
      <div class="flex flex-col justify-center p-8 sm:p-10 lg:px-12 lg:py-12">
        <p class="text-xl font-bold text-ink sm:text-2xl">{homepage.contact.founder.name}</p>
        <p class="mt-1 text-sm text-muted">{homepage.contact.founder.role}</p>
        <p class="mt-5 text-base leading-relaxed text-neutral-600">{homepage.contact.blurb}</p>

        <ul class="mt-8 border-t border-line">
          {contactLinks.map((item) => (
            <li class="border-b border-line">
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="group flex items-center justify-between gap-4 py-3.5 text-sm font-medium text-ink hover:bg-white/70 -mx-2 px-2 rounded-lg"
              >
                <span class="inline-flex items-center gap-3">
                  {item.icon === "web" && (
                    <svg class:list={["h-4 w-4", item.iconClass]} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
                      <path stroke-linecap="round" stroke-width="1.8" d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"/>
                    </svg>
                  )}
                  {item.icon === "linkedin" && (
                    <svg class:list={["h-4 w-4", item.iconClass]} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/>
                    </svg>
                  )}
                  {item.icon === "github" && (
                    <svg class:list={["h-4 w-4", item.iconClass]} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.82.58A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                  )}
                  {item.icon === "email" && (
                    <svg class:list={["h-4 w-4", item.iconClass]} fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                  {item.label}
                </span>
                <span class="text-muted transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </article>
  </div>
</section>
