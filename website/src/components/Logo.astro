---
interface Props {
  class?: string;
  inverted?: boolean;
}

const { class: className = "", inverted = false } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <span class:list={["flex h-8 w-8 items-center justify-center rounded-lg", inverted ? "bg-white text-ink" : "bg-ink text-white"]}>
    <svg class="h-4 w-4" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <circle cx="16" cy="8" r="2.4" fill="currentColor"/>
      <circle cx="9" cy="24" r="2.4" fill="currentColor"/>
      <circle cx="23" cy="24" r="2.4" fill="currentColor"/>
      <path d="M9 24L16 8L23 24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
  </span>
  <span class:list={["text-[17px] font-bold tracking-tight", inverted ? "text-white" : "text-ink"]}>CodeTracr</span>
</span>
