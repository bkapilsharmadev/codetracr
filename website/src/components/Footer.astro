---
import Logo from "./Logo.astro";
import { footerCopy, productNavItems } from "../data/siteCopy";
---

<footer class="border-t border-line bg-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <Logo />
        <p class="mt-3 text-sm text-muted">{footerCopy.tagline}</p>
      </div>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-muted">Product</p>
        <nav class="mt-3 text-[13px] font-medium text-neutral-600">
          {productNavItems.map((item, i) => (
            <>
              {i > 0 && <span class="mx-1.5 text-neutral-300" aria-hidden="true">·</span>}
              <a href={item.href} class="hover:text-ink">{item.label}</a>
            </>
          ))}
        </nav>
      </div>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-muted">{footerCopy.moreFromLabel}</p>
        <nav class="mt-3 text-[13px] font-medium text-neutral-600">
          {footerCopy.moreFrom.map((item, i) => (
            <>
              {i > 0 && <span class="mx-1.5 text-neutral-300" aria-hidden="true">·</span>}
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="hover:text-ink">{item.label}</a>
            </>
          ))}
        </nav>
      </div>
    </div>

    <p class="mt-10 border-t border-line pt-6 text-center text-[12px] text-muted">
      &copy; {new Date().getFullYear()} CodeTracr · MIT Licensed
    </p>
  </div>
</footer>
