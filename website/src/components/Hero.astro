---
import Button from "./Button.astro";
import TraceCard from "./TraceCard.astro";
import { homepage } from "../data/siteCopy";
---

<section class="px-4 pt-16 pb-12 sm:px-6 lg:px-8 lg:pt-24 lg:pb-16 overflow-visible">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-10 items-center">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-3 py-1 mb-7">
        <span class="h-1.5 w-1.5 rounded-full bg-ink"></span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-neutral-600">{homepage.hero.eyebrow}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.08] text-ink max-w-xl">
        {homepage.hero.title}
      </h1>

      <p class="mt-6 text-base sm:text-lg text-neutral-600 max-w-lg leading-relaxed">
        {homepage.hero.description}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={homepage.hero.primaryCta.href}>
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.82.58A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          {homepage.hero.primaryCta.label}
        </Button>
        <Button href={homepage.hero.secondaryCta.href} variant="secondary">
          {homepage.hero.secondaryCta.label} <span aria-hidden="true">→</span>
        </Button>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end min-w-0">
      <TraceCard />
    </div>
  </div>
</section>
